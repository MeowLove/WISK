<ui:FluentWindow x:Class="Wisk.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:local="clr-namespace:Wisk.App" Title="WISK v3.0.0" Width="1440" Height="900" MinWidth="1180" MinHeight="720" Background="{DynamicResource AppWindowBrush}" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Grid.ColumnSpan="2" Title="WISK v3.0.0" ShowMinimize="True" ShowMaximize="True" ShowClose="True" AutomationProperties.Name="WISK title bar"/>
    <Grid Grid.Row="1" x:Name="MainWorkspaceGrid">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="264"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="ExecutionPaneColumn" Width="380"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource AppSidebarBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="24,28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="{local:Loc appName}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <StackPanel Margin="0,8,0,28"><TextBlock Text="{x:Static local:BuildInfo.DisplayVersion}" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11"/><TextBlock Text="{x:Static local:BuildInfo.Provenance}" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="9" Margin="0,3,0,0" TextWrapping="Wrap"/><TextBlock Text="{local:Loc manager}" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1">
          <TextBlock Text="{local:Loc workspace}" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11" FontWeight="SemiBold" Margin="14,0,0,8"/>
          <Button x:Name="HomeNavButton" Style="{StaticResource NavButtonStyle}" Content="{local:Loc home}" AutomationProperties.Name="{local:Loc home}" Tag="Home" Click="Navigate_Click"/>
          <Button x:Name="SystemNavButton" Style="{StaticResource NavButtonStyle}" Content="{local:Loc systemConfiguration}" AutomationProperties.Name="{local:Loc systemConfiguration}" Tag="System" Click="Navigate_Click"/>
          <Button x:Name="RegistryNavButton" Visibility="Collapsed" Style="{StaticResource NavButtonStyle}" Content="{local:Loc registryOptimization}" AutomationProperties.Name="{local:Loc registryOptimization}" Tag="Registry" Click="Navigate_Click"/>
          <Button x:Name="SoftwareNavButton" Style="{StaticResource NavButtonStyle}" Content="{local:Loc software}" AutomationProperties.Name="{local:Loc software}" Tag="Software" Click="Navigate_Click"/>
          <Button x:Name="RecoveryNavButton" Style="{StaticResource NavButtonStyle}" Content="{local:Loc recoveryCenter}" AutomationProperties.Name="{local:Loc recoveryCenter}" Tag="Recovery" Click="Navigate_Click"/>
        </StackPanel>
        <Border Grid.Row="2" Style="{StaticResource PreferencesCardStyle}">
          <StackPanel>
            <DockPanel Margin="0,0,0,12">
              <TextBlock Text="{local:Loc language}" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11" FontWeight="SemiBold"/>
            </DockPanel>
            <ContentControl x:Name="LanguageHost" Margin="0,0,0,10"/>
            <Button x:Name="ThemeButton" Content="Dark theme" Click="Theme_Click" Style="{StaticResource PreferenceButtonStyle}"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Column="1" x:Name="ContentColumnHost" Margin="36,30,28,30">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,26">
        <StackPanel>
          <TextBlock x:Name="PageTitleText" Text="{local:Loc home}" FontSize="30" FontWeight="SemiBold"/>
          <TextBlock x:Name="PageSubtitleText" Text="{local:Loc safePlan}" Foreground="{DynamicResource AppMutedTextBrush}" Margin="0,7,0,0" FontSize="14"/>
        </StackPanel>
      </DockPanel>

      <TabControl Grid.Row="1" x:Name="WorkspaceTabs" Style="{StaticResource WorkspaceTabControlStyle}">
        <TabItem x:Name="HomeTab">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Border Style="{StaticResource SurfaceStyle}" Padding="30" Margin="0,0,0,18">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{local:Loc setupConfidence}" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Text="{local:Loc review}" Foreground="{DynamicResource AppMutedTextBrush}" Margin="0,9,0,22" TextWrapping="Wrap" FontSize="14"/>
                    <StackPanel Orientation="Horizontal">
                      <Button Content="{local:Loc configureSystemButton}" Tag="System" Click="Navigate_Click" Background="{DynamicResource SettingsAccentBrush}" Foreground="White"/>
                      <Button Content="{local:Loc browseSoftwareButton}" Tag="Software" Click="Navigate_Click"/>
                      <Button Content="{local:Loc selfTest}" Click="SelfTest_Click"/>
                    </StackPanel>
                  </StackPanel>
                  <Border Grid.Column="1" Style="{StaticResource StatusBadgeStyle}" VerticalAlignment="Top" MinWidth="170">
                    <StackPanel><TextBlock Text="{local:Loc ready}" FontWeight="SemiBold"/><TextBlock x:Name="HomeSelectionText" Margin="0,6,0,0" Foreground="{DynamicResource AppMutedTextBrush}"/></StackPanel>
                  </Border>
                </Grid>
              </Border>
              <UniformGrid Columns="3" Margin="0,0,0,18">
                <Border Style="{StaticResource StoreCardStyle}" Margin="0,0,12,0"><StackPanel><TextBlock Text="{local:Loc systemCompatibility}" FontWeight="SemiBold"/><TextBlock x:Name="HomeCompatibilityText" Foreground="{DynamicResource AppMutedTextBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                <Border Style="{StaticResource StoreCardStyle}" Margin="0,0,12,0"><StackPanel><TextBlock Text="{local:Loc selectedTasks}" FontWeight="SemiBold"/><TextBlock x:Name="HomeTaskCountText" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="{local:Loc noAutomaticSelection}" Foreground="{DynamicResource AppMutedTextBrush}" Margin="0,2,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource StoreCardStyle}"><StackPanel><TextBlock Text="{local:Loc curatedCatalog}" FontWeight="SemiBold"/><TextBlock Text="{local:Loc catalogSummary}" Foreground="{DynamicResource AppMutedTextBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel></Border>
              </UniformGrid>
              <TextBlock Text="{local:Loc startWorkspace}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,10"/>
              <UniformGrid Columns="3">
                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,12,0"><StackPanel><TextBlock Text="{local:Loc system}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{local:Loc settingsSummary}" Foreground="{DynamicResource AppMutedTextBrush}" Margin="0,8,0,15"/><Button Content="{local:Loc openSettings}" Tag="System" Click="Navigate_Click" HorizontalAlignment="Left"/></StackPanel></Border>
                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,12,0"><StackPanel><TextBlock Text="{local:Loc recoveryCenter}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{local:Loc rollbackCapability}" Foreground="{DynamicResource AppMutedTextBrush}" Margin="0,8,0,15" TextWrapping="Wrap"/><Button Content="{local:Loc recoveryCenter}" Tag="Recovery" Click="Navigate_Click" HorizontalAlignment="Left"/></StackPanel></Border>
                <Border Style="{StaticResource StoreCardStyle}"><StackPanel><TextBlock Text="{local:Loc software}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{local:Loc softwareCatalogSummary}" Foreground="{DynamicResource AppMutedTextBrush}" Margin="0,8,0,15"/><Button Content="{local:Loc browseCatalog}" Tag="Software" Click="Navigate_Click" HorizontalAlignment="Left"/></StackPanel></Border>
              </UniformGrid>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem x:Name="SystemTab">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Grid.Row="1" Margin="0,18,0,10"><TextBlock Text="{local:Loc searchSettings}" Foreground="{DynamicResource AppMutedTextBrush}" Margin="0,0,0,5"/><TextBox x:Name="SearchBox" HorizontalAlignment="Stretch" ToolTip="{local:Loc searchSettings}" TextChanged="Filter_Changed"/><TextBlock Text="{local:Loc unifiedSettingsHint}" Foreground="{DynamicResource AppMutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
            <WrapPanel Grid.Row="2" Margin="0,0,0,10"><Button Content="{local:Loc openWindowsUpdate}" Click="OpenWindowsUpdate_Click"/><Button Content="{local:Loc openPowerSettings}" Click="OpenPowerSettings_Click"/><Button Content="{local:Loc openSystemProtection}" Click="OpenSystemProtection_Click"/></WrapPanel>
            <Grid Grid.Row="3" Margin="0,0,0,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border x:Name="SystemCategoryHost" ClipToBounds="True"><ItemsControl x:Name="SystemCategoryTabs"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding DisplayName}" Tag="{Binding IsSelected}" CommandParameter="{Binding Key}" Click="CategoryTab_Click" Style="{StaticResource CategoryTabButtonStyle}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Border><Button Grid.Row="1" x:Name="SystemCategoryToggle" Content="{local:Loc expandCategories}" Tag="System" Click="CategoryExpansion_Click" Style="{StaticResource CategoryExpansionButtonStyle}" Visibility="Collapsed"/></Grid>
            <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="SystemGrid"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource SettingsCardStyle}" Width="300" Height="238"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><Border Width="42" Height="42" Background="{DynamicResource SettingsAccentBrush}" CornerRadius="10" DockPanel.Dock="Left"><TextBlock Text="{local:Loc settingBadge}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Button Content="{Binding AddLabel}" IsEnabled="{Binding CanAdd}" Tag="{Binding Id}" Click="AddTask_Click" VerticalAlignment="Center" HorizontalAlignment="Right" Padding="10,5" MinHeight="32"/></DockPanel><StackPanel Grid.Row="1" Margin="0,12,0,0"><TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Domain}" Foreground="{DynamicResource AppMutedTextBrush}" Margin="0,5,0,0"/><TextBlock Text="{Binding Availability}" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding SettingMode}" Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding RelationSummary}" Foreground="{DynamicResource AccentBrush}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel><DockPanel Grid.Row="2"><TextBlock Text="{Binding PermissionLabel}" Foreground="{DynamicResource AppMutedTextBrush}" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="{local:Loc details}" Tag="{Binding Id}" Click="TaskDetails_Click" Padding="8,3" MinHeight="28"/></DockPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
            <DockPanel Grid.Row="5" Margin="0,16,0,0"><TextBlock x:Name="SelectionText" Foreground="{DynamicResource AppMutedTextBrush}" VerticalAlignment="Center"/></DockPanel>
          </Grid>
        </TabItem>

        <TabItem x:Name="RegistryTab">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Style="{StaticResource SurfaceStyle}" Padding="22">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="{local:Loc registryOptimization}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{local:Loc registryIntro}" Foreground="{DynamicResource AppMutedTextBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
                <Border Grid.Column="1" Style="{StaticResource StatusBadgeStyle}" VerticalAlignment="Center"><StackPanel><TextBlock Text="{local:Loc registryOperations}" FontWeight="SemiBold"/><TextBlock Text="{local:Loc registryCounts}" Foreground="{DynamicResource AppMutedTextBrush}" Margin="0,4,0,0"/></StackPanel></Border>
              </Grid>
            </Border>
            <DockPanel Grid.Row="1" Margin="0,18,0,10"><TextBox x:Name="RegistrySearchBox" Width="300" ToolTip="{local:Loc searchRegistry}" TextChanged="Filter_Changed"/></DockPanel>
            <Grid Grid.Row="2" Margin="0,0,0,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border x:Name="RegistryCategoryHost" ClipToBounds="True"><ItemsControl x:Name="RegistryCategoryTabs"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding DisplayName}" Tag="{Binding IsSelected}" CommandParameter="{Binding Key}" Click="CategoryTab_Click" Style="{StaticResource CategoryTabButtonStyle}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Border><Button Grid.Row="1" x:Name="RegistryCategoryToggle" Content="{local:Loc expandCategories}" Tag="Registry" Click="CategoryExpansion_Click" Style="{StaticResource CategoryExpansionButtonStyle}" Visibility="Collapsed"/></Grid>
            <DataGrid Grid.Row="3" x:Name="RegistryGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="58" AlternationCount="2">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="{local:Loc add}" Width="104"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding AddLabel}" IsEnabled="{Binding CanAdd}" Tag="{Binding Id}" Click="AddTask_Click" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8,3" MinHeight="30" ToolTip="{Binding Availability}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{local:Loc registryValue}" Width="1.2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Domain}" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="{local:Loc scope}" Binding="{Binding Scope}" Width="70"/>
                <DataGridTextColumn Header="{local:Loc location}" Binding="{Binding Location}" Width="2*"/>
                <DataGridTextColumn Header="{local:Loc targetValue}" Binding="{Binding TargetValue}" Width="1.4*"/>
                <DataGridTemplateColumn Header="{local:Loc details}" Width="84"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{local:Loc details}" Tag="{Binding Id}" Click="TaskDetails_Click" Padding="8,3" MinHeight="30"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <DockPanel Grid.Row="4" Margin="0,16,0,0"><TextBlock x:Name="RegistrySelectionText" Foreground="{DynamicResource AppMutedTextBrush}" VerticalAlignment="Center"/><TextBlock DockPanel.Dock="Right" Text="{local:Loc registryBackupHint}" Foreground="{DynamicResource AppMutedTextBrush}"/></DockPanel>
          </Grid>
        </TabItem>

        <TabItem x:Name="SoftwareTab">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Grid.Row="1" Margin="0,18,0,10">
              <TextBlock Text="{local:Loc searchSoftware}" Foreground="{DynamicResource AppMutedTextBrush}" Margin="0,0,0,5"/><TextBox x:Name="SoftwareSearchBox" HorizontalAlignment="Stretch" ToolTip="{local:Loc searchSoftware}" TextChanged="Filter_Changed"/>
              <WrapPanel Margin="0,8,0,0"><Button Content="{local:Loc refreshSoftwareStatus}" Click="RefreshSoftwareStatus_Click"/><Button Content="{local:Loc manageInstalledApps}" Click="OpenInstalledApps_Click"/></WrapPanel>
              <WrapPanel x:Name="SoftwareStatusFilters" Margin="0,6,0,0">
                <Button Content="{local:Loc allApps}" CommandParameter="all" Style="{StaticResource CategoryTabButtonStyle}" Click="SoftwareStatusFilter_Click"/>
                <Button Content="{local:Loc availableToInstall}" CommandParameter="available" Tag="True" Style="{StaticResource CategoryTabButtonStyle}" Click="SoftwareStatusFilter_Click"/>
                <Button Content="{local:Loc softwareStatusInstalled}" CommandParameter="installed" Style="{StaticResource CategoryTabButtonStyle}" Click="SoftwareStatusFilter_Click"/>
                <Button Content="{local:Loc softwareStatusUpgradeAvailable}" CommandParameter="updates" Style="{StaticResource CategoryTabButtonStyle}" Click="SoftwareStatusFilter_Click"/>
              </WrapPanel>
              <TextBlock Text="{local:Loc inventoryFilterHint}" Foreground="{DynamicResource AppMutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
            <Grid Grid.Row="2" Margin="0,0,0,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border x:Name="SoftwareCategoryHost" ClipToBounds="True"><ItemsControl x:Name="SoftwareCategoryTabs"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding DisplayName}" Tag="{Binding IsSelected}" CommandParameter="{Binding Key}" Click="CategoryTab_Click" Style="{StaticResource CategoryTabButtonStyle}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Border><Button Grid.Row="1" x:Name="SoftwareCategoryToggle" Content="{local:Loc expandCategories}" Tag="Software" Click="CategoryExpansion_Click" Style="{StaticResource CategoryExpansionButtonStyle}" Visibility="Collapsed"/></Grid>
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="SoftwareGrid"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource StoreCardStyle}" Width="274" Height="238"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><Border Width="42" Height="42" Background="{DynamicResource AccentBrush}" CornerRadius="10" DockPanel.Dock="Left"><TextBlock Text="{local:Loc appBadge}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Button Content="{Binding AddLabel}" IsEnabled="{Binding CanAdd}" Tag="{Binding Id}" Click="AddTask_Click" VerticalAlignment="Center" HorizontalAlignment="Right" Padding="10,5" MinHeight="32"/></DockPanel><StackPanel Grid.Row="1" Margin="0,12,0,0"><TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Domain}" Foreground="{DynamicResource AppMutedTextBrush}" Margin="0,5,0,0"/><TextBlock Text="{Binding Availability}" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding PackageId}" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding RelationSummary}" Foreground="{DynamicResource AccentBrush}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel><DockPanel Grid.Row="2"><TextBlock Text="{Binding SoftwareStatus}" Foreground="{DynamicResource AppMutedTextBrush}" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="{local:Loc details}" Tag="{Binding Id}" Click="TaskDetails_Click" Padding="8,3" MinHeight="28"/></DockPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
            <DockPanel Grid.Row="4" Margin="0,16,0,0"><TextBlock x:Name="SoftwareSelectionText" Foreground="{DynamicResource AppMutedTextBrush}" VerticalAlignment="Center"/></DockPanel>
          </Grid>
        </TabItem>

        <TabItem x:Name="RecoveryTab">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="180"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Style="{StaticResource SurfaceStyle}" Padding="22"><StackPanel><TextBlock Text="{local:Loc recoveryCenter}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{local:Loc recoverySubtitle}" Foreground="{DynamicResource AppMutedTextBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></Border>
            <WrapPanel Grid.Row="1" Margin="0,18,0,12"><Button Content="{local:Loc refreshRecovery}" Click="RefreshRecovery_Click"/><Button Content="{local:Loc openSystemRestore}" Click="OpenSystemRestore_Click"/><Button Content="{local:Loc openSystemProtection}" Click="OpenSystemProtection_Click"/><Button Content="{local:Loc openBackupFolder}" Click="OpenBackupFolder_Click"/></WrapPanel>
            <DataGrid Grid.Row="2" x:Name="RecoveryRunsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="RecoveryRunsGrid_SelectionChanged" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
              <DataGrid.Columns><DataGridTextColumn Header="{local:Loc executionBatch}" Binding="{Binding RunId}" Width="*"/><DataGridTextColumn Header="{local:Loc updatedAt}" Binding="{Binding UpdatedAt}" Width="170"/><DataGridTextColumn Header="{local:Loc backupItems}" Binding="{Binding RecordCount}" Width="100"/></DataGrid.Columns>
            </DataGrid>
            <DataGrid Grid.Row="3" x:Name="RecoveryRecordsGrid" Margin="0,12,0,0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
              <DataGrid.Columns><DataGridTextColumn Header="{local:Loc task}" Binding="{Binding TaskName}" Width="1.2*"/><DataGridTextColumn Header="{local:Loc registryLocation}" Binding="{Binding Location}" Width="2*"/><DataGridTextColumn Header="{local:Loc restoreValue}" Binding="{Binding RestoreExpression}" Width="1.2*"/></DataGrid.Columns>
            </DataGrid>
            <DockPanel Grid.Row="4" Margin="0,14,0,0"><TextBlock x:Name="RecoverySummaryText" Foreground="{DynamicResource AppMutedTextBrush}" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="{local:Loc exportSelectedRollback}" Click="ExportRecoveryRollback_Click"/></DockPanel>
          </Grid>
        </TabItem>

      </TabControl>
    </Grid>

    <Border x:Name="ExecutionPane" Grid.Column="2" Background="{DynamicResource AppSidebarBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1,0,0,0">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="18,20,14,12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel x:Name="ExecutionPaneHeader"><TextBlock Text="{local:Loc planExecution}" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="QueueCountText" Foreground="{DynamicResource AppMutedTextBrush}" Margin="0,4,0,0"/></StackPanel>
          <Button Grid.Column="1" x:Name="ExecutionPaneToggleButton" Content="›" ToolTip="{local:Loc collapseExecution}" Click="ExecutionPaneToggle_Click" Width="36" Height="36" Padding="0" FontSize="20"/>
        </Grid>
        <UniformGrid x:Name="ExecutionViewTabs" Grid.Row="1" Columns="2" Margin="14,0,14,12">
          <Button x:Name="PendingViewButton" Content="{local:Loc pendingPlan}" Tag="Pending" Click="ExecutionView_Click" Background="{DynamicResource ActiveNavBrush}" BorderBrush="{DynamicResource ActiveNavBorderBrush}"/>
          <Button x:Name="CompletedViewButton" Content="{local:Loc completedRuns}" Tag="Completed" Click="ExecutionView_Click"/>
        </UniformGrid>
        <Grid x:Name="PendingExecutionView" Grid.Row="2">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border x:Name="RunSummaryPanel" Margin="14,0,14,10" Background="{DynamicResource BadgeBrush}" BorderBrush="{DynamicResource BadgeBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
            <StackPanel><TextBlock Text="{local:Loc currentPlan}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/><TextBlock x:Name="RunSummaryText" Text="{local:Loc selectToPlan}" Foreground="{DynamicResource AppMutedTextBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
          </Border>
          <Border Grid.Row="1" Margin="14,0,14,10" Background="{DynamicResource AppPanelBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10"><StackPanel><TextBlock Text="{local:Loc planImpact}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/><TextBlock x:Name="PlanImpactText" Text="{local:Loc noPlanImpact}" Foreground="{DynamicResource AppMutedTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/><TextBlock x:Name="RestorePointRecommendationText" Text="{local:Loc restorePointRecommended}" Foreground="{DynamicResource SettingsAccentBrush}" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"/><Button x:Name="RestorePointRecommendationButton" Content="{local:Loc addRestorePoint}" Tag="safety-restore-point" Click="AddTask_Click" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="8,3" MinHeight="28" Visibility="Collapsed"/></StackPanel></Border>
          <DataGrid Grid.Row="2" x:Name="ExecutionGrid" Margin="14,0,14,10" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="None">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="" Width="38"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding StatusGlyph}" Foreground="{Binding StatusBrush}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTemplateColumn Header="{local:Loc task}" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding DisplayName}"/><TextBlock Text="{Binding ConfigurationSummary}" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="{local:Loc state}" Binding="{Binding StateDisplay}" Width="92"/>
              <DataGridTemplateColumn Header="" Width="104"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="{Binding EditLabel}" IsEnabled="{Binding CanConfigure}" Tag="{Binding InstanceId}" Click="EditQueueItem_Click" Padding="6,2" Margin="0,0,4,0"/><Button Content="{Binding RemoveLabel}" Tag="{Binding InstanceId}" Click="RemoveQueueItem_Click" Padding="6,2"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Grid.Row="3" x:Name="ExecutionText" Margin="16,0,16,10" Foreground="{DynamicResource AppMutedTextBrush}" TextWrapping="Wrap" MaxHeight="58"/>
          <StackPanel x:Name="ExecutionPaneActions" Grid.Row="4" Margin="14,0,14,18">
            <CheckBox x:Name="AllowElevatedCheck" Content="{local:Loc authorizeElevated}"/>
            <CheckBox x:Name="AllowHighRiskCheck" Content="{local:Loc authorizeHigh}" Margin="0,6,0,10" FontWeight="SemiBold"/>
            <UniformGrid Columns="2"><Button Content="{local:Loc runPreflight}" Click="Preflight_Click"/><Button Content="{local:Loc simulatePlan}" Click="SimulatePlan_Click"/><Button x:Name="ResumeButton" Content="{local:Loc resume}" Click="Resume_Click"/><Button Content="{local:Loc diagnostics}" Click="ExportDiagnostics_Click"/><Button Content="{local:Loc importPlanTemplate}" Click="ImportPlanTemplate_Click"/><Button Content="{local:Loc exportPlanTemplate}" Click="ExportPlanTemplate_Click"/><Button Content="{local:Loc exportRegistryRollback}" Click="ExportRegistryRollback_Click"/><Button x:Name="CancelButton" Content="{local:Loc cancel}" Click="Cancel_Click" IsEnabled="False"/></UniformGrid>
            <Button x:Name="ApplyButton" Content="{local:Loc apply}" Click="Apply_Click" Background="{DynamicResource AccentBrush}" Foreground="White" Margin="4,10,4,0"/>
          </StackPanel>
        </Grid>
        <Grid x:Name="CompletedExecutionView" Grid.Row="2" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="150"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border Margin="14,0,14,10" Background="{DynamicResource BadgeBrush}" BorderBrush="{DynamicResource BadgeBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"><StackPanel><TextBlock Text="{local:Loc completedRuns}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{local:Loc completedRunsHint}" Foreground="{DynamicResource AppMutedTextBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></Border>
          <DataGrid Grid.Row="1" x:Name="CompletedRunsGrid" Margin="14,0,14,10" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" SelectionChanged="CompletedRunsGrid_SelectionChanged">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="" Width="38"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding StatusGlyph}" Foreground="{Binding StatusBrush}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTemplateColumn Header="{local:Loc completedBatch}" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11" TextWrapping="Wrap"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="{local:Loc state}" Binding="{Binding StateDisplay}" Width="92"/>
            </DataGrid.Columns>
          </DataGrid>
          <DataGrid Grid.Row="2" x:Name="CompletedTasksGrid" Margin="14,0,14,8" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" SelectionChanged="CompletedTasksGrid_SelectionChanged">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="" Width="30"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding StatusGlyph}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTemplateColumn Header="{local:Loc task}" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Code}" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="{local:Loc state}" Binding="{Binding StateDisplay}" Width="78"/>
              <DataGridTemplateColumn Header="" Width="68"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{local:Loc retryTask}" IsEnabled="{Binding CanRetry}" Tag="{Binding TaskId}" Click="RetryFailedTask_Click" Padding="5,2"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <Border Grid.Row="3" Margin="14,0,14,8" Padding="10" Background="{DynamicResource BadgeBrush}" BorderBrush="{DynamicResource BadgeBorderBrush}" BorderThickness="1" CornerRadius="6"><TextBlock x:Name="CompletedTaskDetailsText" Text="{local:Loc selectCompletedTask}" Foreground="{DynamicResource AppMutedTextBrush}" TextWrapping="Wrap" MaxHeight="92"/></Border>
          <UniformGrid Grid.Row="4" Columns="2" Margin="14,0,14,18"><Button Content="{local:Loc viewDetails}" Click="CompletedRunDetails_Click"/><Button x:Name="ResumeCompletedButton" Content="{local:Loc resume}" Click="Resume_Click"/><Button Content="{local:Loc exportSelectedRollback}" Click="ExportRegistryRollback_Click"/><Button Content="{local:Loc refreshHistory}" Click="RefreshHistory_Click"/><Button Content="{local:Loc cleanupHistory}" Click="CleanupHistory_Click"/></UniformGrid>
        </Grid>
        <Button x:Name="CollapsedExecutionButton" Grid.RowSpan="3" Visibility="Collapsed" Content="‹" ToolTip="{local:Loc openExecution}" Click="ExecutionPaneToggle_Click" Width="38" Height="38" Padding="0" Margin="8,20,8,0" VerticalAlignment="Top" FontSize="20"/>
      </Grid>
    </Border>
  </Grid>
  </Grid>
</ui:FluentWindow>
