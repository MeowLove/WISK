{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://windowsinitializer.local/schemas/profile.v2.json",
  "title": "WISK V2 profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profileId", "tasks", "target", "policy", "allowElevated", "allowHighRisk"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "profileId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumBuild", "architecture", "requireWindows11"],
      "properties": {
        "minimumBuild": { "type": "integer", "minimum": 26100 },
        "architecture": { "const": "x64" },
        "requireWindows11": { "const": true }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stopOnError", "maxRetries"],
      "properties": {
        "stopOnError": { "type": "boolean" },
        "maxRetries": { "type": "integer", "minimum": 0, "maximum": 5 },
        "defaultTimeout": { "type": ["string", "null"], "format": "duration" },
        "retryBaseDelay": { "type": ["string", "null"], "format": "duration" }
      }
    },
    "allowElevated": { "type": "boolean" },
    "allowHighRisk": { "type": "boolean" },
    "proxy": { "type": ["string", "null"], "minLength": 1, "maxLength": 2048 },
    "parameters": {
      "type": ["object", "null"],
      "maxProperties": 256,
      "propertyNames": { "minLength": 1, "maxLength": 128 },
      "additionalProperties": { "type": "string", "maxLength": 4096 }
    },
    "accounts": {
      "type": ["array", "null"],
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "passwordNeverExpires", "hideFromSignInScreen", "allowRemoteDesktop"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 20, "pattern": "^[A-Za-z0-9._-]+$" },
          "fullName": { "type": ["string", "null"], "maxLength": 256 },
          "description": { "type": ["string", "null"], "maxLength": 1024 },
          "groupSid": { "enum": [null, "S-1-5-32-544", "S-1-5-32-545"] },
          "passwordNeverExpires": { "type": "boolean" },
          "hideFromSignInScreen": { "type": "boolean" },
          "allowRemoteDesktop": { "type": "boolean" },
          "password": { "type": ["string", "null"], "maxLength": 256 }
        }
      }
    }
  }
}
