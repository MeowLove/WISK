;=================================================================================
; PART 4: �Ҽ��˵���չ (HKEY_LOCAL_MACHINE\SOFTWARE\Classes)
;=================================================================================
[-HKEY_CLASSES_ROOT\*\shell\TakeOwnership]
[-HKEY_CLASSES_ROOT\*\shell\runas]
[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\*\shell\TakeOwnership]
@="Take Ownership"
"HasLUAShield"=""
"NoWorkingDirectory"=""
[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\*\shell\TakeOwnership\command]
@="powershell -windowstyle hidden -command \"Start-Process cmd -ArgumentList '/c takeown /f \\\"%1\\\" && icacls \\\"%1\\\" /grant *S-1-3-4:F /t /c /l & pause' -Verb runAs\""
[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\Directory\shell\TakeOwnership]
@="Take Ownership"
"AppliesTo"="NOT (System.ItemPathDisplay:=\"C:\\Users\" OR System.ItemPathDisplay:=\"C:\\ProgramData\" OR System.ItemPathDisplay:=\"C:\\Windows\" OR System.ItemPathDisplay:=\"C:\\Windows\\System32\" OR System.ItemPathDisplay:=\"C:\\Program Files\" OR System.ItemPathDisplay:=\"C:\\Program Files (x86)\")"
"HasLUAShield"=""
"NoWorkingDirectory"=""
"Position"="middle"
[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\Directory\shell\TakeOwnership\command]
@="powershell -windowstyle hidden -command \"$Y = ($null | choice).Substring(1,1); Start-Process cmd -ArgumentList ('/c takeown /f \\\"%1\\\" /r /d ' + $Y + ' && icacls \\\"%1\\\" /grant *S-1-3-4:F /t /c /l /q & pause') -Verb runAs\""
[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\Drive\shell\runas]
@="Take Ownership"
"HasLUAShield"=""
"NoWorkingDirectory"=""
"Position"="middle"
"AppliesTo"="NOT (System.ItemPathDisplay:=\"C:\\\")"
[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\Drive\shell\runas\command]
@="cmd.exe /c takeown /f \"%1\\\" /r /d y && icacls \"%1\\\" /grant *S-1-3-4:F /t /c & Pause"

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\*\shell\hash]
"MUIVerb"="Hash Check"
"SubCommands"=""
"Icon"="PowerShell.exe"
[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\*\shell\hash\shell\001menu]
"MUIVerb"="SHA1"
"Icon"="PowerShell.exe"
[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\*\shell\hash\shell\001menu\command]
@="powershell -noexit get-filehash -literalpath \\\"%1\\\" -algorithm SHA1 | format-list"
[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\*\shell\hash\shell\002menu]
"MUIVerb"="SHA256"
"Icon"="PowerShell.exe"
[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\*\shell\hash\shell\002menu\command]
@="powershell -noexit get-filehash -literalpath \\\"%1\\\" -algorithm SHA256 | format-list"
[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\*\shell\hash\shell\003menu]
"MUIVerb"="SHA384"
"Icon"="PowerShell.exe"
[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\*\shell\hash\shell\003menu\command]
@="powershell -noexit get-filehash -literalpath \\\"%1\\\" -algorithm SHA384 | format-list"
[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\*\shell\hash\shell\004menu]
"MUIVerb"="SHA512"
"Icon"="PowerShell.exe"
[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\*\shell\hash\shell\004menu\command]
@="powershell -noexit get-filehash -literalpath \\\"%1\\\" -algorithm SHA512 | format-list"
[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\*\shell\hash\shell\005menu]
"MUIVerb"="MACTripleDES"
"Icon"="PowerShell.exe"
[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\*\shell\hash\shell\005menu\command]
@="powershell -noexit get-filehash -literalpath \\\"%1\\\" -algorithm MACTripleDES | format-list"
[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\*\shell\hash\shell\006menu]
"MUIVerb"="MD5"
