<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>WindowsInitializer</AssemblyName>
    <Title>WISK</Title>
    <Product>WISK</Product>
    <Description>WISK Windows initialization and configuration workspace.</Description>
    <RootNamespace>WindowsInitializer.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Version>3.0.0</Version>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <FileVersion>3.0.0.0</FileVersion>
    <SourceCommit Condition="'$(SourceCommit)' == ''">local</SourceCommit>
    <BuildTimestampUtc Condition="'$(BuildTimestampUtc)' == ''">development</BuildTimestampUtc>
    <SignatureStatus Condition="'$(SignatureStatus)' == ''">NotSignedInLocalBuild</SignatureStatus>
    <InformationalVersion>$(Version)+$(SourceCommit)</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="SourceCommit" Value="$(SourceCommit)" />
    <AssemblyMetadata Include="BuildTimestampUtc" Value="$(BuildTimestampUtc)" />
    <AssemblyMetadata Include="SignatureStatus" Value="$(SignatureStatus)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <ProjectReference Include="..\WindowsInitializer.Contracts\WindowsInitializer.Contracts.csproj" />
    <ProjectReference Include="..\WindowsInitializer.Core\WindowsInitializer.Core.csproj" />
    <ProjectReference Include="..\WindowsInitializer.Platform.Windows\WindowsInitializer.Platform.Windows.csproj" />
    <ProjectReference Include="..\WindowsInitializer.PowerShell\WindowsInitializer.PowerShell.csproj" />
  </ItemGroup>
</Project>
