<Window x:Class="WindowsInitializer.App.ConfigurationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WindowsInitializer.App"
        Title="{local:Loc taskConfiguration}" Width="560" Height="560" MinWidth="480" MinHeight="460"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppWindowBrush}">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="{local:Loc configureInputs}" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="{local:Loc valuesValidated}" Foreground="{DynamicResource AppMutedTextBrush}" Margin="0,4,0,16" TextWrapping="Wrap" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <StackPanel x:Name="ComputerNamePanel" Margin="0,0,0,14">
          <TextBlock Text="{local:Loc computerName}" FontWeight="SemiBold" />
          <TextBox x:Name="ComputerNameBox" Margin="0,6,0,0" ToolTip="{local:Loc computerNameHint}" />
        </StackPanel>
        <StackPanel x:Name="DeviceRegionPanel" Margin="0,0,0,14">
          <TextBlock Text="{local:Loc deviceRegionGeoId}" FontWeight="SemiBold" />
          <TextBox x:Name="DeviceRegionBox" Margin="0,6,0,0" ToolTip="{local:Loc numericGeoId}" />
        </StackPanel>
        <StackPanel x:Name="LanguageUiPanel" Margin="0,0,0,14">
          <TextBlock Text="{local:Loc windowsLanguageTag}" FontWeight="SemiBold" />
          <TextBox x:Name="LanguageUiBox" Margin="0,6,0,0" ToolTip="{local:Loc languageTagExample}" />
        </StackPanel>
        <StackPanel x:Name="FontSupplementPanel" Margin="0,0,0,14">
          <TextBlock Text="{local:Loc supplementalFonts}" FontWeight="SemiBold" />
          <TextBlock Text="{local:Loc supplementalFontsHint}" Foreground="{DynamicResource AppMutedTextBrush}" Margin="0,4,0,8" TextWrapping="Wrap" />
          <CheckBox x:Name="JapaneseFontsBox" Content="{local:Loc fontJapanese}" Tag="japanese" Margin="0,3,0,0" />
          <CheckBox x:Name="KoreanFontsBox" Content="{local:Loc fontKorean}" Tag="korean" Margin="0,3,0,0" />
          <CheckBox x:Name="EuropeanFontsBox" Content="{local:Loc fontEuropean}" Tag="european" Margin="0,3,0,0" />
          <CheckBox x:Name="IndicFontsBox" Content="{local:Loc fontIndic}" Tag="indic" Margin="0,3,0,0" />
        </StackPanel>
        <StackPanel x:Name="WindowsUpdateModePanel" Margin="0,0,0,14">
          <TextBlock Text="{local:Loc windowsUpdateMode}" FontWeight="SemiBold" />
          <ComboBox x:Name="WindowsUpdateModeBox" Margin="0,6,0,0" SelectedIndex="0">
            <ComboBoxItem Tag="default" Content="{local:Loc updateModeDefault}" />
            <ComboBoxItem Tag="notify-download" Content="{local:Loc updateModeNotifyDownload}" />
            <ComboBoxItem Tag="auto-notify-install" Content="{local:Loc updateModeAutoNotifyInstall}" />
          </ComboBox>
        </StackPanel>
        <StackPanel x:Name="PowerPlanPanel" Margin="0,0,0,14">
          <TextBlock Text="{local:Loc activePowerPlan}" FontWeight="SemiBold" />
          <ComboBox x:Name="PowerPlanBox" Margin="0,6,0,0" SelectedIndex="0">
            <ComboBoxItem Tag="balanced" Content="{local:Loc powerPlanBalanced}" />
            <ComboBoxItem Tag="high-performance" Content="{local:Loc powerPlanHighPerformance}" />
            <ComboBoxItem Tag="power-saver" Content="{local:Loc powerPlanPowerSaver}" />
            <ComboBoxItem Tag="ultimate-performance" Content="{local:Loc powerPlanUltimatePerformance}" />
          </ComboBox>
        </StackPanel>
        <StackPanel x:Name="SleepTimeoutPanel" Margin="0,0,0,14">
          <TextBlock Text="{local:Loc sleepAndDisplayTimeouts}" FontWeight="SemiBold" />
          <TextBlock Text="{local:Loc timeoutMinutesHint}" Foreground="{DynamicResource AppMutedTextBrush}" Margin="0,4,0,8" TextWrapping="Wrap" />
          <UniformGrid Columns="2">
            <StackPanel Margin="0,0,6,8"><TextBlock Text="{local:Loc sleepAcMinutes}"/><TextBox x:Name="SleepAcBox" Text="30" Margin="0,4,0,0"/></StackPanel>
            <StackPanel Margin="6,0,0,8"><TextBlock Text="{local:Loc sleepDcMinutes}"/><TextBox x:Name="SleepDcBox" Text="15" Margin="0,4,0,0"/></StackPanel>
            <StackPanel Margin="0,0,6,0"><TextBlock Text="{local:Loc displayAcMinutes}"/><TextBox x:Name="DisplayAcBox" Text="10" Margin="0,4,0,0"/></StackPanel>
            <StackPanel Margin="6,0,0,0"><TextBlock Text="{local:Loc displayDcMinutes}"/><TextBox x:Name="DisplayDcBox" Text="5" Margin="0,4,0,0"/></StackPanel>
          </UniformGrid>
        </StackPanel>
        <StackPanel x:Name="RegistryBooleanPanel" Margin="0,0,0,14">
          <TextBlock x:Name="RegistryBooleanTitle" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
          <TextBlock x:Name="RegistryBooleanHint" Foreground="{DynamicResource AppMutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
          <TextBlock Text="{local:Loc registrySettingState}" FontWeight="SemiBold" />
          <ComboBox x:Name="RegistryBooleanBox" Margin="0,6,0,0" SelectedIndex="0">
            <ComboBoxItem Tag="enabled" Content="{local:Loc registrySettingEnabled}" />
            <ComboBoxItem Tag="disabled" Content="{local:Loc registrySettingDisabled}" />
            <ComboBoxItem Tag="default" Content="{local:Loc registrySettingDefault}" />
          </ComboBox>
        </StackPanel>
        <StackPanel x:Name="AccountPanel" Margin="0,0,0,14">
          <TextBlock Text="{local:Loc localAccount}" FontWeight="SemiBold" />
          <ListBox x:Name="AccountList" Margin="0,6,0,8" MinHeight="42" DisplayMemberPath="DisplaySummary" />
          <TextBox x:Name="AccountNameBox" Margin="0,6,0,0" ToolTip="{local:Loc accountNameHint}" />
          <PasswordBox x:Name="AccountPasswordBox" Margin="0,6,0,0" ToolTip="{local:Loc passwordHint}" />
          <TextBox x:Name="AccountFullNameBox" Margin="0,6,0,0" ToolTip="{local:Loc optionalFullName}" />
          <CheckBox x:Name="AccountAdminBox" Content="{local:Loc addAdministrators}" Margin="0,8,0,0" />
          <CheckBox x:Name="AccountNeverExpiresBox" Content="{local:Loc passwordNeverExpires}" Margin="0,4,0,0" />
          <CheckBox x:Name="AccountHiddenBox" Content="{local:Loc hideSignIn}" Margin="0,4,0,0" />
          <CheckBox x:Name="AccountRemoteDesktopBox" Content="{local:Loc allowRemoteDesktop}" Margin="0,4,0,0" />
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="{local:Loc addAccount}" Click="AddAccount_Click" />
            <Button Content="{local:Loc removeSelectedAccount}" Click="RemoveAccount_Click" Margin="8,0,0,0" />
          </StackPanel>
          <TextBlock Text="{local:Loc passwordPrivacy}" Foreground="{DynamicResource AppMutedTextBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock x:Name="NoInputText" Text="{local:Loc noAdditionalConfiguration}" Foreground="{DynamicResource AppMutedTextBrush}" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="{local:Loc cancel}" IsCancel="True" Margin="0,0,8,0" />
      <Button Content="{local:Loc continue}" IsDefault="True" Click="Continue_Click" Background="{DynamicResource AccentBrush}" Foreground="White" />
    </StackPanel>
  </Grid>
</Window>
