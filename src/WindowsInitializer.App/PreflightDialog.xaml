<ui:FluentWindow x:Class="WindowsInitializer.App.PreflightDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:WindowsInitializer.App"
    Title="{local:Loc preflightTitle}" Width="720" Height="620"
    MinWidth="600" MinHeight="480" WindowStartupLocation="CenterOwner"
    Background="{DynamicResource AppWindowBrush}" Foreground="{DynamicResource AppTextBrush}">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="{local:Loc preflightTitle}" FontSize="26" FontWeight="SemiBold"/>
    <TextBlock Grid.Row="1" x:Name="SummaryText" Margin="0,8,0,18"
               Foreground="{DynamicResource AppMutedTextBrush}" TextWrapping="Wrap"/>
    <DataGrid Grid.Row="2" x:Name="ChecksGrid" AutoGenerateColumns="False" IsReadOnly="True"
              CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
      <DataGrid.Columns>
        <DataGridTextColumn Header="" Binding="{Binding Glyph}" Width="42"/>
        <DataGridTextColumn Header="{local:Loc check}" Binding="{Binding Name}" Width="170"/>
        <DataGridTextColumn Header="{local:Loc state}" Binding="{Binding Status}" Width="105"/>
        <DataGridTextColumn Header="{local:Loc message}" Binding="{Binding Message}" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="{local:Loc close}" Click="Close_Click" MinWidth="100"/>
      <Button x:Name="ContinueButton" Content="{local:Loc continueExecution}" Click="Continue_Click"
              Background="{DynamicResource AccentBrush}" Foreground="White" MinWidth="130"/>
    </StackPanel>
  </Grid>
</ui:FluentWindow>
