<ui:FluentWindow x:Class="WindowsInitializer.App.TaskDetailsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:WindowsInitializer.App"
    Title="{local:Loc taskDetails}" Width="680" Height="650" MinWidth="560" MinHeight="500"
    WindowStartupLocation="CenterOwner" Background="{DynamicResource AppWindowBrush}" Foreground="{DynamicResource AppTextBrush}">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock x:Name="TitleText" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="SummaryText" Margin="0,8,0,20" Foreground="{DynamicResource AppMutedTextBrush}" TextWrapping="Wrap"/></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{local:Loc currentState}" FontWeight="SemiBold" Margin="0,7"/><TextBlock Grid.Column="1" x:Name="CurrentStateText" Margin="0,7" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="1" Text="{local:Loc targetState}" FontWeight="SemiBold" Margin="0,7"/><TextBlock Grid.Row="1" Grid.Column="1" x:Name="TargetStateText" Margin="0,7" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="2" Text="{local:Loc configuration}" FontWeight="SemiBold" Margin="0,7"/><TextBlock Grid.Row="2" Grid.Column="1" x:Name="ConfigurationText" Margin="0,7" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="3" Text="{local:Loc packageId}" FontWeight="SemiBold" Margin="0,7"/><TextBlock Grid.Row="3" Grid.Column="1" x:Name="PackageText" Margin="0,7" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="4" Text="{local:Loc permissionImpact}" FontWeight="SemiBold" Margin="0,7"/><TextBlock Grid.Row="4" Grid.Column="1" x:Name="PermissionText" Margin="0,7" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="5" Text="{local:Loc dependencies}" FontWeight="SemiBold" Margin="0,7"/><TextBlock Grid.Row="5" Grid.Column="1" x:Name="DependenciesText" Margin="0,7" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="6" Text="{local:Loc resourceImpact}" FontWeight="SemiBold" Margin="0,7"/><TextBlock Grid.Row="6" Grid.Column="1" x:Name="ResourcesText" Margin="0,7" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="7" Text="{local:Loc executionBoundary}" FontWeight="SemiBold" Margin="0,7"/><TextBlock Grid.Row="7" Grid.Column="1" x:Name="BoundaryText" Margin="0,7" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="8" Text="{local:Loc rollbackCapability}" FontWeight="SemiBold" Margin="0,7"/><TextBlock Grid.Row="8" Grid.Column="1" x:Name="RollbackText" Margin="0,7" TextWrapping="Wrap"/>
      </Grid>
    </ScrollViewer>
    <Button Grid.Row="2" Content="{local:Loc close}" Click="Close_Click" HorizontalAlignment="Right" MinWidth="110" Margin="0,18,0,0"/>
  </Grid>
</ui:FluentWindow>
