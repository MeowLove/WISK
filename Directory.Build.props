<Project>
  <PropertyGroup>
    <WiskVersion>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)VERSION').Trim())</WiskVersion>
    <Version Condition="'$(Version)' == ''">$(WiskVersion)</Version>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">$(WiskVersion).0</AssemblyVersion>
    <FileVersion Condition="'$(FileVersion)' == ''">$(WiskVersion).0</FileVersion>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
